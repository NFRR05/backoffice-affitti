# Copia questo file in .env.local e compila solo quello che ti serve.
# Senza nessuna variabile l'app funziona in locale: database nella cartella ./data,
# messaggi WhatsApp ed email SIMULATI (li vedi nella pagina Messaggi).

# --- Database ---
# Vuoto = database locale PGlite in ./data/pglite (nessuna installazione).
# Per Supabase: Project Settings > Database > Connection string (URI), regione Francoforte.
DATABASE_URL=

# --- Attività pianificata ---
# Protegge /api/cron/tick. Obbligatoria in produzione.
CRON_SECRET=

# --- WhatsApp Business (Cloud API di Meta) ---
# Vuote = messaggi simulati.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=it

# --- Email (SMTP) per l'invio dei rendiconti ---
# Vuote = email simulate (il PDF viene comunque generato e archiviato).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Gestione Appartamenti <rendiconti@tuodominio.it>"
